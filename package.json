{
  "name": "profile",
  "private": true,
  "description": "Portfolio site. Static index.html plus a Tailwind stylesheet built with the Tailwind CLI.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
