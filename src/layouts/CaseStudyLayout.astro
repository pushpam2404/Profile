---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import StatusTag from '~/components/StatusTag.astro';
import { buildWarehouse } from '~/lib/warehouse';
import { formatValue, formatFooter } from '~/lib/format';
import type { Verification } from '~/content.config';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;

const wh = await buildWarehouse();
const claims = wh.fact_claim.filter((c) => c.project_id === project.id);

const stripProtocol = (url: string) => url.replace(/^https?:\/\//, '');
---
<BaseLayout title={`${p.name} — Pushpam Raj Satyarthi`} description={p.summary}>
  <article class="case-study">
    <header class="case-header">
      <h1>{p.name}</h1>
      <p class="summary prose-measure">{p.summary}</p>
    </header>

    <div class="case-grid">
      <aside class="rail" aria-label="Project details">
        <dl>
          <div class="field">
            <dt>year</dt>
            <dd>{p.year}</dd>
          </div>
          <div class="field">
            <dt>context</dt>
            <dd>{p.context}</dd>
          </div>
          <div class="field">
            <dt>status</dt>
            <dd>{p.status.replaceAll('-', ' ')}</dd>
          </div>
          <div class="field">
            <dt>stack</dt>
            <dd>{p.stack.join(', ')}</dd>
          </div>
          <div class="field">
            <dt>repository</dt>
            <dd>
              {p.repo_url ? (
                <a href={p.repo_url} rel="noopener">{stripProtocol(p.repo_url)}</a>
              ) : (
                'NULL'
              )}
            </dd>
          </div>
          <div class="field">
            <dt>live</dt>
            <dd>
              {p.live_url ? (
                <a href={p.live_url} rel="noopener">{stripProtocol(p.live_url)}</a>
              ) : (
                'NULL'
              )}
            </dd>
          </div>
        </dl>
      </aside>

      <div class="main">
        <div class="narrative prose-measure">
          <slot />
        </div>

        <section class="claims" aria-labelledby="claims-heading">
          <h2 id="claims-heading">Claims</h2>
          {claims.length > 0 ? (
            <figure class="result">
              <table class="claims-table">
                <caption class="sr-only">Claims recorded for {p.name}</caption>
                <thead>
                  <tr>
                    <th scope="col">metric</th>
                    <th scope="col" class="numeric">value</th>
                    <th scope="col">verification</th>
                    <th scope="col">method</th>
                  </tr>
                </thead>
                <tbody>
                  {claims.flatMap((c) => [
                    <tr>
                      <td>{c.metric}</td>
                      <td class="numeric">
                        {formatValue(c.value as string | null, c.unit as string | null)}
                      </td>
                      <td><StatusTag status={c.verification as Verification} /></td>
                      <td>{(c.method as string | null) ?? 'NULL'}</td>
                    </tr>,
                    c.caveat && (
                      <tr class="caveat-row">
                        <td colspan="4">
                          <details>
                            <summary>What this does not prove</summary>
                            <p>{c.caveat}</p>
                          </details>
                        </td>
                      </tr>
                    ),
                  ])}
                </tbody>
              </table>
              <figcaption class="footer">{formatFooter(claims.length, 0.003)}</figcaption>
            </figure>
          ) : (
            <p class="prose-measure">No claims are recorded for this project yet.</p>
          )}
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-header {
    margin-top: 1rem;
  }

  h1 {
    font-family: var(--font-prose);
    font-weight: 400;
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
    margin: 0 0 1rem;
  }

  .summary {
    font-size: var(--text-body);
    color: var(--color-ink-soft);
    margin: 0;
  }

  .case-grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: start;
    margin-top: 2.5rem;
  }

  .rail dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rail dt {
    font-family: var(--font-data);
    font-size: var(--text-label);
    color: var(--color-ink-soft);
    margin: 0 0 0.25rem;
  }

  .rail dd {
    font-family: var(--font-data);
    font-size: var(--text-data);
    margin: 0;
  }

  .rail dd a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    word-break: break-word;
  }

  .main {
    min-width: 0;
  }

  .narrative :global(h2) {
    font-family: var(--font-prose);
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    margin: 2.5rem 0 1rem;
  }

  .narrative :global(h2:first-child) {
    margin-top: 0;
  }

  .narrative :global(p) {
    margin: 0 0 1rem;
  }

  .claims {
    margin-top: 3rem;
  }

  .claims h2 {
    font-family: var(--font-prose);
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    margin: 0 0 1rem;
  }

  .result {
    margin: 0;
    overflow-x: auto;
  }

  .result .footer {
    font-family: var(--font-data);
    font-size: var(--text-label);
    color: var(--color-ink-soft);
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .claims-table tr {
    background-color: transparent;
  }

  .caveat-row td {
    padding-top: 0;
    padding-bottom: 1rem;
  }

  details {
    font-family: var(--font-prose);
    font-size: var(--text-small);
    color: var(--color-ink-soft);
  }

  details summary {
    cursor: pointer;
    font-family: var(--font-data);
    font-size: var(--text-label);
    color: var(--color-ink);
  }

  details[open] summary {
    margin-bottom: 0.5rem;
  }

  details p {
    margin: 0;
    max-width: 60ch;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .case-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .rail dl {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem 2rem;
    }
  }
</style>
