---
import { pipeline } from '../data/site';
const nodes = [
  { x: 0, label: 'Sources' },
  { x: 195, label: 'Transform' },
  { x: 390, label: 'Warehouse' },
];
---

<figure class="rounded-3xl border border-line bg-surface p-5 md:p-7" data-reveal>
  <svg viewBox="0 0 520 130" class="w-full" aria-hidden="true" focusable="false">
    <g stroke="var(--border)" stroke-width="2" stroke-dasharray="4 5" fill="none">
      <path d="M130 65H195" />
      <path d="M325 65H390" />
    </g>
    {nodes.map((n) => (
      <g>
        <rect x={n.x} y="25" width="130" height="80" rx="14" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.5" />
        <text x={n.x + 65} y="70" text-anchor="middle" font-family="var(--font-mono)" font-size="17" fill="var(--text)">{n.label}</text>
      </g>
    ))}
    {[0, 0.85, 1.7].map((d) => <circle class="packet" cx="130" cy="65" r="4.5" fill="var(--accent)" style={`--run:65px;--d:${d}`} />)}
    {[0.4, 1.25, 2.1].map((d) => <circle class="packet" cx="325" cy="65" r="4.5" fill="var(--accent)" style={`--run:65px;--d:${d}`} />)}
  </svg>
  <dl class="mt-6 grid gap-5">
    {pipeline.map((n, i) => (
      <div class="grid grid-cols-[2rem_1fr] gap-x-3">
        <dt class="t-label pt-1 text-accent">{String(i + 1).padStart(2, '0')}</dt>
        <dd>
          <p class="font-semibold">{n.title} <span class="t-label ml-1 font-normal text-ink3">{n.note}</span></p>
          <p class="mt-1 text-[0.95rem] text-ink2">{n.desc}</p>
        </dd>
      </div>
    ))}
  </dl>
  <figcaption class="t-label mt-6 border-t border-line pt-4 text-ink3">Illustrative ETL flow, not live data</figcaption>
</figure>
