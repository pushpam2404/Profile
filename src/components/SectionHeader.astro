---
interface Props { index: string; title: string; lead?: string }
const { index, title, lead } = Astro.props;
const hues: Record<string, string> = { '01': 'blue', '02': 'teal', '03': 'amber', '04': 'violet', '05': 'red' };
const h = hues[index] ?? 'red';
---

<header class="mb-10 grid gap-x-6 gap-y-3 border-b border-line pb-6 md:mb-14 md:grid-cols-[3rem_1fr_minmax(0,22rem)] md:items-baseline" data-reveal>
  <p class="t-label" style={`color:var(--c-${h}-ink)`} aria-hidden="true">{index}</p>
  <h2 class="t-h2">{title}</h2>
  {lead && <p class="j text-ink2">{lead}</p>}
</header>
