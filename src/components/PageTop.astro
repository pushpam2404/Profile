---
import Masthead from './Masthead.astro';
import { nav, site } from '../data/site';

// The masthead and ruled strip that open every page (after harryjatkins.com).
interface Props { reveal?: boolean }
const { reveal = false } = Astro.props;
void reveal;
const home = Astro.url.pathname === '/' ? '' : '/';
const links = nav.filter((n) => n.id !== 'contact');
---

<div class="relative z-10">
  <!-- The masthead is fixed under the nav and shrinks as the page scrolls (see scripts/site.ts). The spacer holds its place in the flow. -->
  <div class="mast-spacer" aria-hidden="true"></div>
  <div class="mast-fixed" data-mast>
    <Masthead words />
  </div>

  <!-- From tablet width the strip is a second bar tucked behind the masthead: it slides out as you scroll up and back in as you scroll down, in step with the scroll (see scripts/site.ts). -->
  <div class="strip-spacer" aria-hidden="true"></div>
  <div class="strip-fixed" data-strip>
  <div class="hero-strip">
    <p>
      <span class="ink">{site.name}</span>
      {site.role}
    </p>
    <nav aria-label="On this page">
      <ul>
        {links.map((n) => (
          <li>
            <a href={`${home}#${n.id}`} data-nav-link={n.id}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div role="group" aria-label="Display modes (keyboard shortcuts T, D and M)">
      <button type="button" class="mode" data-mode="text" aria-pressed="false" aria-keyshortcuts="T">
        <span>Text mode</span><span class="mode-state" aria-hidden="true" data-mode-state>( <span class="mode-letter">N</span> )</span>
      </button>
      <button type="button" class="mode" data-mode="dark" aria-pressed="false" aria-keyshortcuts="D">
        <span>Dark mode</span><span class="mode-state" aria-hidden="true" data-mode-state>( <span class="mode-letter">N</span> )</span>
      </button>
      <button type="button" class="mode" data-mode="mono" aria-pressed="false" aria-keyshortcuts="M">
        <span>Monochrome</span><span class="mode-state" aria-hidden="true" data-mode-state>( <span class="mode-letter">N</span> )</span>
      </button>
    </div>
    <p class="place">Visakhapatnam,<br />India</p>
  </div>
  </div>
</div>
