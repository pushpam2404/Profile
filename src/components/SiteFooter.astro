---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="method">
      Every claim on this site is logged in a public ledger and marked
      verified, measured, self-reported, or untested — see the
      <a href="/claims">claims ledger</a>.
    </p>
    <ul class="contact">
      <li><a href="mailto:prsatyarthi2404@gmail.com">prsatyarthi2404@gmail.com</a></li>
      <li><a href="https://github.com/pushpam2404" rel="me">github.com/pushpam2404</a></li>
      <li><a href="https://www.linkedin.com/in/pushpamrajsatyarthi/" rel="me">linkedin.com/in/pushpamrajsatyarthi</a></li>
    </ul>
    <p class="colophon">© {year} Pushpam Raj Satyarthi</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    background-color: var(--color-bar);
  }

  .site-footer__inner {
    max-width: 68rem;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: 1.5rem 2rem;
  }

  .method {
    font-family: var(--font-prose);
    font-size: var(--text-small);
    color: var(--color-ink-soft);
    max-width: 40ch;
    margin: 0;
  }

  .method a {
    color: var(--color-ink);
  }

  .contact {
    font-family: var(--font-data);
    font-size: var(--text-small);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact a {
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .contact a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .colophon {
    font-family: var(--font-data);
    font-size: var(--text-label);
    color: var(--color-ink-soft);
    margin: 0;
    width: 100%;
  }
</style>
