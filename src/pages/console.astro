---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResultTable from '~/components/ResultTable.astro';
import type { Column } from '~/components/ResultTable.astro';
import { buildWarehouse, TABLE_NAMES } from '~/lib/warehouse';
import { EXAMPLE_QUERIES } from '~/lib/example-queries';
import { formatValue } from '~/lib/format';

const wh = await buildWarehouse();

// Rendered at build time so the schema is readable with no JavaScript at all.
const schema = TABLE_NAMES.map((name) => ({
  name,
  columns: Object.keys(wh[name][0] ?? {}),
  rows: wh[name].length,
}));

const fallbackColumns: Column[] = [
  { key: 'metric', label: 'metric' },
  { key: 'value', label: 'value', numeric: true },
  { key: 'verification', label: 'status', type: 'status' },
];

const fallbackRows = wh.fact_claim.map((c) => ({
  metric: c.metric,
  value: formatValue(c.value as string | null, c.unit as string | null),
  verification: c.verification,
}));

const openingQuery = EXAMPLE_QUERIES[0]!;
---

<BaseLayout
  title="Console — Pushpam Raj Satyarthi"
  description="Query the claims, projects and credentials behind this site directly, in your browser."
>
  <h1>Console</h1>

  <p class="prose-measure intro">
    This page runs DuckDB in your browser against the same data the rest of the
    site renders from. Nothing is sent anywhere — the database is a static file
    your browser downloads. Only <code>SELECT</code> runs here.
  </p>

  <div class="console-grid">
    <aside class="rail" aria-labelledby="schema-heading">
      <h2 id="schema-heading">Schema</h2>
      <dl class="schema">
        {schema.map((t) => (
          <div class="table-def">
            <dt>{t.name}</dt>
            <dd>
              <span class="rowcount">{t.rows} rows</span>
              <ul>{t.columns.map((c) => <li>{c}</li>)}</ul>
            </dd>
          </div>
        ))}
      </dl>
    </aside>

    <section class="pane" aria-labelledby="query-heading">
      <h2 id="query-heading" class="sr-only">Query editor</h2>

      <label class="sr-only" for="console-editor">SQL query</label>
      <textarea
        id="console-editor"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        rows="7"
        aria-describedby="console-hint">{openingQuery.sql}</textarea>

      <div class="controls">
        <button type="button" id="console-run">Run</button>
        <span id="console-hint" class="hint">
          Control-Enter runs the query. Escape leaves the editor.
        </span>
      </div>

      <p id="console-error" class="error" role="alert" hidden></p>
      <p id="console-status" class="sr-only" role="status" aria-live="polite"></p>

      <figure class="result">
        <table>
          <caption class="sr-only">Query results</caption>
          <thead id="console-head"></thead>
          <tbody id="console-body"></tbody>
        </table>
        <figcaption id="console-footer" class="footer"></figcaption>
      </figure>

      <section aria-labelledby="examples-heading" class="examples">
        <h2 id="examples-heading">Saved queries</h2>
        <ul>
          {EXAMPLE_QUERIES.map((q) => (
            <li>
              <button type="button" data-example-sql={q.sql}>{q.title}</button>
            </li>
          ))}
        </ul>
      </section>
    </section>
  </div>

  <section id="console-fallback" aria-labelledby="fallback-heading">
    <h2 id="fallback-heading">Every claim, without JavaScript</h2>
    <p class="prose-measure">
      The editor above needs JavaScript to run the database. The full claims
      table is below regardless, and <a href="/claims.csv">claims.csv</a> has
      every column.
    </p>
    <ResultTable
      columns={fallbackColumns}
      rows={fallbackRows}
      caption="Every claim, rendered without JavaScript"
      footerSeconds={0.003}
    />
  </section>
</BaseLayout>

<script>
  import '~/scripts/console-ui';
</script>

<style>
  .intro { margin-bottom: 2rem; }
  code { font-family: var(--font-data); font-size: 0.9em; }

  .console-grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .rail h2, .examples h2 {
    font-size: var(--text-h3);
    margin: 0 0 0.75rem;
  }

  .schema { margin: 0; font-family: var(--font-data); font-size: var(--text-label); }
  .table-def { margin-bottom: 1rem; }
  .schema dt { color: var(--color-ink); border-bottom: 1px solid var(--color-rule); }
  .schema dd { margin: 0.35rem 0 0; color: var(--color-ink-soft); }
  .rowcount { display: block; margin-bottom: 0.2rem; }
  .schema ul { list-style: none; margin: 0; padding: 0; }
  .schema li { padding-left: 0.75rem; }

  textarea {
    width: 100%;
    font-family: var(--font-data);
    font-size: var(--text-data);
    color: var(--color-ink);
    background: var(--color-bar);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    padding: 0.75rem;
    resize: vertical;
  }

  .controls {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0.75rem 0 1rem;
    flex-wrap: wrap;
  }

  button {
    font-family: var(--font-data);
    font-size: var(--text-label);
    color: var(--color-paper);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-control);
    padding: 0.4rem 1.1rem;
    cursor: pointer;
  }
  button:disabled { opacity: 0.55; cursor: default; }

  .hint { font-family: var(--font-data); font-size: var(--text-label); color: var(--color-ink-soft); margin: 0; }

  /*
    An error is not a claim, so it must not borrow a verification hue. It is
    distinguished by treatment: a band and a left rule, not by meaning it
    does not have.
  */
  .error {
    font-family: var(--font-data);
    font-size: var(--text-data);
    color: var(--color-ink);
    background: var(--color-bar);
    border-left: 3px solid var(--color-ink-soft);
    padding: 0.6rem 0.75rem;
    margin: 0 0 1rem;
  }

  .result { margin: 0; overflow-x: auto; }
  .footer {
    font-family: var(--font-data);
    font-size: var(--text-label);
    color: var(--color-ink-soft);
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-rule);
    min-height: 1.4em;
  }

  .examples { margin-top: 2rem; }
  .examples ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  .examples button {
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-rule);
    text-align: left;
  }

  #console-fallback { margin-top: 3rem; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 768px) {
    .console-grid { grid-template-columns: 1fr; }
  }
</style>
