---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResultTable from '~/components/ResultTable.astro';
import type { Column } from '~/components/ResultTable.astro';
import { buildWarehouse } from '~/lib/warehouse';
import { formatValue } from '~/lib/format';

const wh = await buildWarehouse();

const orgName = (orgId: string | null) =>
  wh.dim_org.find((o) => o.org_id === orgId)?.name ?? orgId;

// The framing figure below is pulled from the ledger's own claim, not
// retyped, so the two can never drift out of sync.
const trackClaim = wh.fact_claim.find((c) => c.claim_id === 'ibm-data-engineering-track');
if (!trackClaim) throw new Error('Expected the ibm-data-engineering-track claim in the warehouse.');
const trackCount = formatValue(trackClaim.value as string | null, trackClaim.unit as string | null);

/** The verify URL's own accession code — the last path segment — used as link text. */
const codeFromUrl = (url: string) => url.replace(/\/+$/, '').split('/').pop() ?? url;

const credentialColumns = [
  { key: 'name', label: 'credential' },
  { key: 'issuer', label: 'issuer' },
  { key: 'issued_on', label: 'issued' },
  { key: 'code', label: 'verify', type: 'link', hrefKey: 'verify_url' },
] satisfies Column[];

const credentialRows = wh.dim_credential.map((c) => ({
  name: c.name,
  issuer: orgName(c.issuer_id as string | null),
  issued_on: c.issued_on,
  code: codeFromUrl(c.verify_url as string),
  verify_url: c.verify_url,
}));
---
<BaseLayout
  title="Credentials — Pushpam Raj Satyarthi"
  description="Twelve credentials, each with its own public verification link, including 11 of 16 IBM Data Engineering courses completed so far."
>
  <header class="intro">
    <h1>Credentials</h1>
    <p class="prose-measure">
      The resume lists the IBM Data Engineering Professional Certificate as a
      credential. It is not yet one: {trackCount}, in progress. The eleven
      completed courses, issued between August 2025 and September 2026, cover
      data engineering fundamentals, Python, SQL and relational database
      administration, Linux and shell scripting, ETL pipelines with Airflow
      and Kafka, data warehousing, BI dashboarding with Cognos and Looker,
      and NoSQL databases.
    </p>
    <p class="prose-measure">
      Every row below links to its own public verification record — a
      Coursera accomplishment page for the eleven IBM courses, and a GITAM
      credentials page for the twelfth: an Internal Smart India Hackathon
      2026 qualification. The link text is that record's own accession code.
    </p>
  </header>

  <ResultTable
    columns={credentialColumns}
    rows={credentialRows}
    caption="Twelve credentials, each linking to its own public verification record"
    footerSeconds={0.003}
  />
</BaseLayout>

<style>
  .intro {
    margin-top: 1rem;
  }

  h1 {
    font-family: var(--font-prose);
    font-weight: 400;
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
    margin: 0 0 1rem;
  }

  .intro p {
    margin: 0 0 1rem;
  }
</style>
