---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import { packRows, shotsFor } from '../../lib/shots';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const shots = shotsFor(project.id, d.shots);
const [cover, ...rest] = shots;
const rows = packRows(rest);
const hasSheet = shots.length > 0 || !!d.snippet;
const statusLabel = { live: 'Live', 'in-development': 'In development', prototype: 'Prototype', 'code-only': 'Code only', 'no-public-repo': 'No public repository' }[d.status];
---

<BaseLayout title={`${d.title} | ${site.name}`} description={d.tagline} path={`/projects/${project.id}/`}>
  <article class="wrap pt-3 pb-24 md:pt-3" style={`--pc:var(--text-3); --pc-ink:var(--text-2)`}>
    <PageTop />

    <!-- Spec sheet: the screenshot beside a ruled label/value table (after harryjatkins.com project pages). -->
    <div class="vt-sheet mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
      {hasSheet && (
        <div class="sheet self-start lg:col-span-7" aria-label={`Screenshots of ${d.title}`}>
          {cover ? (
            <div class="sheet-row" style={`aspect-ratio: ${cover.aspect}; view-transition-name: shot-${project.id}; view-transition-class: shot`}>
              <Image src={cover.img} alt={cover.alt} widths={[720, 1100, 1440]} sizes="(min-width: 1200px) 700px, 100vw" loading="eager" />
            </div>
          ) : (
            <pre class="sheet-code" tabindex="0" aria-label={`Source excerpt from ${d.snippet!.file}`}><code>{d.snippet!.code}</code></pre>
          )}
          {rows.map((row, i) => {
            const sum = row.reduce((t, x) => t + x.aspect, 0);
            return (
              <div class="sheet-row grow" style={`--i:${i}; max-width:${Math.min(1, sum / 1.6) * 100}%`}>
                {row.map((x) => (
                  <div style={`flex: ${x.aspect} 1 0; aspect-ratio: ${x.aspect}`}>
                    <Image src={x.img} alt={x.alt} widths={[360, 560, 800]} sizes="(min-width: 1200px) 700px, 100vw" loading="lazy" />
                  </div>
                ))}
              </div>
            );
          })}
        </div>
      )}
      <div class:list={['lg:self-start', hasSheet ? 'lg:col-span-5' : 'lg:col-span-12 lg:max-w-3xl']}>
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="t-label" style="color:var(--pc-ink)">{String(d.order).padStart(2, '0')} · {d.context}</p>
            <h1 class="t-h2 mt-3">{d.title}</h1>
          </div>
          <a href="/#projects" class="close-btn" aria-label="Close and go back to all projects"><span aria-hidden="true">—</span></a>
        </div>
        <p class="j mt-4 text-ink2">{d.tagline}</p>
        <dl class="spec mt-8">
          <div><dt>ID</dt><dd>{String(d.order).padStart(2, '0')}</dd></div>
          <div><dt>Role</dt><dd>{d.role}</dd></div>
          <div><dt>Status</dt><dd>{statusLabel}</dd></div>
          {d.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          <div><dt>Stack</dt><dd>{d.stack.join(', ')}</dd></div>
          {d.links.repo && <div><dt>Source</dt><dd><a class="underline decoration-line underline-offset-4 hover:decoration-accent" href={d.links.repo} target="_blank" rel="noopener">{d.links.repo.replace('https://github.com/', '')}<span class="sr-only"> (opens in a new tab)</span></a></dd></div>}
          {d.links.live && <div><dt>Live</dt><dd><a class="underline decoration-line underline-offset-4 hover:decoration-accent" href={d.links.live} target="_blank" rel="noopener">{d.links.live.replace('https://', '')}<span class="sr-only"> (opens in a new tab)</span></a></dd></div>}
        </dl>
      </div>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <section class="lg:col-span-7" aria-labelledby="what">
        <h2 id="what" class="t-label mb-4 text-ink3">What it does</h2>
        <ul class="grid gap-5">
          {d.points.map((pt) => (
            <li class="flex gap-4 border-b border-line pb-5 last:border-b-0">
              <span aria-hidden="true" class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent"></span>
              <span class="t-prose j">{pt}</span>
            </li>
          ))}
        </ul>
      </section>
      <aside class="grid content-start gap-10 lg:col-span-5">
        {d.limits.length > 0 && (
          <section aria-labelledby="limits" class="rounded-2xl border border-line bg-surface p-5">
            <h2 id="limits" class="t-label mb-3 text-ink3">Worth knowing</h2>
            <ul class="grid gap-3 text-[0.95rem] text-ink2">{d.limits.map((l) => <li class="j">{l}</li>)}</ul>
          </section>
        )}
      </aside>
    </div>

    <nav aria-label="More projects" class="mt-20 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {prev ? <a href={`/projects/${prev.id}/`} class="rounded-2xl border border-line p-5 transition-colors hover:border-ink3"><span class="t-label text-ink3">← Previous</span><span class="t-h3 mt-1 block">{prev.data.title}</span></a> : <span />}
      {next ? <a href={`/projects/${next.id}/`} class="rounded-2xl border border-line p-5 text-left transition-colors hover:border-ink3 sm:text-right"><span class="t-label text-ink3">Next →</span><span class="t-h3 mt-1 block">{next.data.title}</span></a> : <span />}
    </nav>
  </article>
</BaseLayout>
